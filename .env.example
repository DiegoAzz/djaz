# ==========================================
# MiniDJ — Variables de Entorno
# ==========================================

# Puerto del servidor backend
PORT=3001

# Entorno de ejecución
NODE_ENV=production

# Clave de YouTube Data API v3 (Obtenida gratis en Google Cloud Console)
# Si se deja vacía o con el placeholder, MiniDJ activa automáticamente el modo demostración
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Orígenes permitidos para CORS (en producción coloca tu dominio o *)
CORS_ORIGIN=*
